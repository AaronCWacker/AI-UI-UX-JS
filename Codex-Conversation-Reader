UI(){const b=$('#playBtn');b.setAttribute('aria-pressed',this.speaking&&!this.paused?'true':'false');b.textContent=this.speaking&&!this.paused?'❚❚':'▶';b.setAttribute('aria-label',this.speaking&&!this.paused?'Pause reading':(this.paused?'Resume reading':'Read aloud'));},\n  clearHi(){document.querySelectorAll('.speaking').forEach(e=>e.classList.remove('speaking'));},\n  speakCurrent(){\n    if(!this.supported){toast('Read-aloud isn\\'t available in this browser.');return;}\n    const myId=++this.id;speechSynthesis.cancel();\n    const u=new SpeechSynthesisUtterance(speech.text);const v=this.voice();if(v){u.voice=v;u.lang=v.lang;}\n    u.rate=+$('#rateIn').value;u.pitch=+$('#pitchIn').value;\n    const segs=speech.segs;let lastEl=null;\n    u.onboundary=e=>{if(myId!==this.id)return;if(e.name&&e.name!=='word')return;this.lastBoundary=performance.now();stats.words++;engine&&engine.pulse(.9);\n      const s=segs.find(sg=>e.charIndex>=sg.start&&e.charIndex\u003csg.end);if(s&&s.el!==lastEl){lastEl&&lastEl.classList.remove('speaking');s.el.classList.add('speaking');lastEl=s.el;}};\n    u.onend=()=>{if(myId!==this.id)return;this.clearHi();\n      if($('#keepIn').checked){const nv=nextView(view);if(nv){go(nv,{fromReader:true});setTimeout(()=>{if(myId===this.id&&this.speaking)this.speakCurrent();},900);return;}}\n      this.speaking=false;this.paused=false;this.setUI();this.stopKeepAlive();};\n    u.onerror=e=>{if(myId!==this.id)return;if(e.error==='interrupted'||e.error==='canceled')return;toast('Reading stopped: '+e.error);this.speaking=false;this.setUI();};\n    this.speaking=true;this.paused=false;this.lastBoundary=performance.now();this.setUI();\n    speechSynthesis.speak(u);this.startKeepAlive(v);\n  },\n  startKeepAlive(v){this.stopKeepAlive();if(v&&v.localService)return;this.keepAlive=setInterval(()=>{if(speechSynthesis.speaking&&!this.paused){speechSynthesis.pause();speechSynthesis.resume();}},10000);},\n  stopKeepAlive(){clearInterval(this.keepAlive);this.keepAlive=