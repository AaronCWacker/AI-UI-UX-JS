  const pa=posBuf.toAttribute(),ta=tgtBuf.toAttribute();\n  mat.positionNode=pa.xyz;\n  const hr=hash(instanceIndex.add(31));\n  mat.scaleNode=U.size.mul(hr.mul(.9).add(.35)).mul(clamp(pa.w.mul(3).add(1),1,2.2));\n  const cw=ta.w;\n  const base=mix(mix(U.c1,U.c2,smoothstep(0,.5,cw)),U.c3,smoothstep(.5,1,cw));\n  const col=mix(base,U.spark,clamp(pa.w.mul(4),0,1).mul(.8));\n  const dd=uv().sub(.5).length();\n  const alpha=oneMinus(smoothstep(0,.5,dd)).pow(2.2);\n  mat.colorNode=vec4(col.mul(U.gain),alpha);\n  const sprite=new THREE.Sprite(mat);sprite.count=N;sprite.frustumCulled=false;scene.add(sprite);\n\n  const post=new THREE.PostProcessing(renderer);\n  const scenePass=pass(scene,camera);const sceneTex=scenePass.getTextureNode('output');\n  post.outputNode=sceneTex.add(bloom(sceneTex,.85,.45,.08));\n\n  // palette targets\n  const pal={c1:new THREE.Color(),c2:new THREE.Color(),c3:new THREE.Color(),spark:new THREE.Color()};\n  function setPalette(p){pal.c1.set(p.pal[0]);pal.c2.set(p.pal[1]);pal.c3.set(p.pal[2]);pal.spark.set(p.spark);}\n\n  // pointer repulsion\n  const ray=new THREE.Raycaster(),ndc=new THREE.Vector2(),plane=new THREE.Plane(),hit=new THREE.Vector3(),camDir=new THREE.Vector3();let ptrTarget=0;\n  renderer.domElement.addEventListener('pointermove',e=>{const r=renderer.domElement.getBoundingClientRect();ndc.set((e.clientX-r.left)/r.width*2-1,-(e.clientY-r.top)/r.height*2+1);ray.setFromCamera(ndc,camera);camera.getWorldDirection(camDir);plane.setFromNormalAndCoplanarPoint(camDir,new THREE.Vector3());if(ray.ray.intersectPlane(plane,hit))U.ptr.value.copy(hit);ptrTarget=.35;});\n  renderer.domElement.addEventListener('pointerleave',()=>{ptrTarget=0;});\n\n  function layout(){\n    const w=innerWidth,h=innerHeight;renderer.setSize(w,h);camera.aspect=w/h;\n    const wide=w>860,sp=$('#spine'),fo=$('#folio');\n    let ox=0,oy=0;\n    if(wide){const left=sp.getBoundingClientRect().right,right=w-fo.getBoundingClientRect().left;ox=(right-left)/2;}\n    else{oy=M