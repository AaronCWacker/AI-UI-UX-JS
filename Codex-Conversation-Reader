==============================================\n   VIEW STATE + FOLIO\n   ============================================================ */\nlet view={kind:'home'};let speech={text:'',segs:[]};\nconst partsEl=$('#parts');\nconst chBtns=[];const partHeads=[];\nPARTS.forEach((p,pi)=>{\n  const sec=el('section','part');\n  const head=el('button','part-head');head.setAttribute('aria-expanded','false');\n  head.append(el('span','',p.e),el('span','roman',p.r),el('span','pt',p.t));\n  head.addEventListener('click',()=>head.setAttribute('aria-expanded',head.getAttribute('aria-expanded')==='true'?'false':'true'));\n  const ol=el('ol','chs');\n  CH.filter(c=>c.p===pi).forEach(c=>{const li=el('li');const b=el('button');b.append(el('span','n',String(c.n)),el('span','',`${c.e} ${c.t}`));b.addEventListener('click',()=>{go({kind:'ch',i:c.i});closeSpineMobile();});chBtns[c.i]=b;li.append(b);ol.append(li);});\n  sec.append(head,ol);partsEl.append(sec);partHeads[pi]=head;\n});\n$('.home-link').addEventListener('click',()=>{go({kind:'home'});closeSpineMobile();});\n\nfunction wordsInto(container,text,segAdd,{dropcap=false}={}){\n  const words=text.split(/(\\s+)/);let first=true;\n  for(const w of words){\n    if(!w)continue;\n    if(/^\\s+$/.test(w)){container.append(document.createTextNode(' '));segAdd(' ');continue;}\n    const s=el('span','w');\n    if(dropcap&&first&&/^[A-Za-z]/.test(w)){const dc=el('span','dropcap',w[0]);s.append(dc,document.createTextNode(w.slice(1)));}\n    else s.textContent=w;\n    first=false;container.append(s);segAdd(w,s);\n  }\n}\nfunction joinNames(arr){if(arr.length\u003c2)return arr.join('');return arr.slice(0,-1).join(', ')+(arr.length>2?',':'')+' and '+arr[arr.length-1];}\n\nfunction renderFolio(){\n  const f=$('#folio');f.innerHTML='';let text='';const segs=[];\n  const add=(s,elm)=>{const st=text.length;text+=s;if(elm)segs.push({start:st,end:text.length,el:elm});};\n  const sealBtn=code=>{const [t,a,e]=BOOKS[code];const b=el('button','seal');b.title=