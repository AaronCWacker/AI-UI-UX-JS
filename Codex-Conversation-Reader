<style>
/* One quiet reading column on lapis night, gilt for structure, a docked narrator bar at the bottom */
:root{
  color-scheme:dark;
  --night:#0b1230; --panel:#0e1738; --gilt:#d6ad55; --gilt-dim:rgba(214,173,85,.32);
  --vellum:#efe4cb; --muted:#a9b1cc; --verdigris:#62b5a3; --code:#060a1c; --hi:#fff3cf;
  --display:"IM Fell English","Iowan Old Style","Palatino Linotype",Palatino,Georgia,serif;
  --ui:"Alegreya Sans","Gill Sans","Segoe UI",system-ui,sans-serif;
  --mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
}
*,*::before,*::after{box-sizing:border-box}
html{scroll-padding-top:calc(env(safe-area-inset-top,0px) + 70px)}
body{background:var(--night);color:var(--vellum);font-family:var(--ui);font-size:17px;line-height:1.6;-webkit-font-smoothing:antialiased}
button,select,input{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:2px solid var(--gilt);outline-offset:2px;border-radius:3px}

.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:3;background:rgba(11,18,48,.94);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);border-bottom:1px solid var(--gilt-dim)}
.top-in{max-width:78ch;margin:0 auto;padding:10px 16px;display:flex;flex-wrap:wrap;gap:8px 12px;align-items:center}
.top h1{margin:0;font-family:var(--display);font-weight:400;font-size:1.25rem;flex:1 1 14rem;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.top select,.btn{background:#14204a;border:1px solid var(--gilt-dim);border-radius:6px;padding:.32rem .55rem;font-size:.9rem;max-width:100%}
.btn:hover{border-color:var(--gilt)}
.meta{font-size:.82rem;color:var(--muted);font-variant-numeric:tabular-nums}

main{max-width:78ch;margin:0 auto;padding-inline:16px;padding-block:24px 140px}
#doc{font-family:var(--display);font-size:1.12rem;line-height:1.65}
#doc h1,#doc h2,#doc h3,#doc h4{font-weight:400;line-height:1.15;text-wrap:balance}
#doc h1{font-size:2rem;margin:.6em 0 .4em}
#doc h2{font-size:1.5rem;margin:1.4em 0 .4em}
#doc h2.turn{font-family:var(--ui);font-size:.82rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--gilt);border-top:1px solid var(--gilt-dim);padding-top:1.4rem;margin-top:2.2rem}
#doc h3{font-size:1.2rem;font-style:italic;color:var(--gilt);margin:1.1em 0 .3em}
#doc p{margin:0 0 .8em}
#doc ul,#doc ol{font-family:var(--ui);font-size:1.02rem;padding-left:1.3rem;margin:.2em 0 .9em}
#doc li{margin:.25em 0}
#doc li::marker{color:var(--gilt)}
#doc strong{color:#fff6dc}
#doc hr{border:0;border-top:1px solid var(--gilt-dim);margin:1.4em 0}
#doc a{color:var(--verdigris)}
#doc :not(pre)>code{font-family:var(--mono);font-size:.84em;background:rgba(27,42,92,.7);color:var(--gilt);border-radius:4px;padding:.05em .35em}
#doc blockquote{margin:0 0 1em;padding-left:1rem;border-left:2px solid var(--gilt)}
.tbl{overflow-x:auto;margin:.4em 0 1.1em;border:1px solid var(--gilt-dim);border-radius:6px}
#doc table{border-collapse:collapse;width:100%;font-family:var(--ui);font-size:.95rem;font-variant-numeric:tabular-nums}
#doc th,#doc td{padding:.4rem .65rem;border-bottom:1px solid rgba(214,173,85,.14)}
#doc th{font-size:.8rem;font-weight:500;color:var(--muted);vertical-align:bottom}
#doc tr:last-child td{border-bottom:0}
details.code{margin:.2em 0 1.1em;border:1px solid var(--gilt-dim);border-radius:8px;background:rgba(6,10,28,.45)}
details.code summary{cursor:pointer;padding:.5rem .8rem;font-family:var(--ui);font-size:.88rem;color:var(--muted)}
details.code pre{margin:0;max-height:60vh;overflow:auto;padding:12px;background:var(--code);border-top:1px solid rgba(214,173,85,.15);border-radius:0 0 8px 8px;font:12.5px/1.5 var(--mono);color:#cdd3ea;white-space:pre}

[data-blk]{cursor:pointer;border-radius:4px;transition:background .2s}
[data-blk]:hover{background:rgba(255,255,255,.035)}
.reading{background:rgba(214,173,85,.12)!important;box-shadow:0 0 0 4px rgba(214,173,85,.12)}
.w.on{color:var(--hi);text-shadow:0 0 12px rgba(214,173,85,.85)}

#bar{position:fixed;left:0;right:0;bottom:0;z-index:4;background:var(--panel);border-top:1px solid var(--gilt-dim);box-shadow:0 -10px 40px rgba(0,0,0,.4);padding:8px 16px calc(env(safe-area-inset-bottom,0px) + 8px)}
.bar-in{max-width:78ch;margin:0 auto;display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px}
.play{width:46px;height:46px;border-radius:50%;border:1px solid var(--gilt);background:radial-gradient(circle at 35% 30%,#f1cf7c,#b4862e);color:#1a1405;display:grid;place-items:center;font-size:1.05rem;box-shadow:0 0 22px rgba(214,173,85,.3)}
.play[aria-pressed="true"]{background:radial-gradient(circle at 35% 30%,#8fe1cf,#3c8f7f)}
.stop{width:38px;height:38px;border-radius:50%;border:1px solid var(--gilt-dim);background:none;display:grid;place-items:center}
.stop:hover{border-color:var(--gilt)}
.fld{display:flex;flex-direction:column;gap:2px;font-size:.72rem;color:var(--muted)}
.fld select{background:#14204a;border:1px solid var(--gilt-dim);border-radius:6px;padding:.28rem .4rem;font-size:.86rem;max-width:220px}
.fld input[type=range]{width:90px;accent-color:var(--gilt)}
.keep{display:flex;align-items:center;gap:.35rem;font-size:.86rem}
.keep input{accent-color:var(--verdigris);width:16px;height:16px}
#now{font-size:.82rem;color:var(--muted);flex:1 1 10rem;min-width:0}
#toast{position:fixed;z-index:6;left:50%;transform:translateX(-50%);top:calc(env(safe-area-inset-top,0px) + 64px);background:var(--panel);border:1px solid var(--gilt);border-radius:8px;padding:.45rem .85rem;font-size:.9rem;opacity:0;pointer-events:none;transition:opacity .25s;max-width:calc(100% - 32px)}
#toast.show{opacity:1}
@media (max-width:640px){ .fld.opt{display:none} #now{flex-basis:100%;order:9} .fld select{max-width:150px} #doc{font-size:1.04rem} }
@media (prefers-reduced-motion:reduce){ *{transition:none!important} }
</style>

