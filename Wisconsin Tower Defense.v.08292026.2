 e+=38*gauss(lat,lon,44.88,-87.38,.82,.24);
 e-=60*gauss(lat,lon,44.10,-89.80,1.0,1.35);
 e-=32*gauss(lat,lon,43.63,-89.77,.15,.18);
 e+=noise2(lat,lon)*32;
