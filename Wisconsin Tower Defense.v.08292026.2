let sixtyRecorder=null,sixtyChunks=[],sixtyStream=null,sixtyStopTimer=0;
function pickVideoMime(){
  const mp4=[
    'video/mp4;codecs="avc1.42E01E,mp4a.40.2"',
    'video/mp4;codecs="avc1.4D401F,mp4a.40.2"',
    'video/mp4;codecs=avc1.42E01E',
    'video/mp4'
  ];
  return mp4.find(x=>window.MediaRecorder&&MediaRecorder.isTypeSupported(x))||(['video/webm;codecs=vp9,opus','video/webm'].find(x=>window.MediaRecorder&&MediaRecorder.isTypeSupported(x))||'');
}
async function start60Recording(){
  if(sixtyRecorder){toast('🎬 MP4 recorder already running');return}$('record60Btn').classList.add('active');$('record60Btn').textContent='⏹️';
  try{if(navigator.mediaDevices?.getDisplayMedia){sixtyStream=await navigator.mediaDevices.getDisplayMedia({video:{frameRate:60},audio:true});toast('🎬 Choose THIS TAB + Share tab audio',3000)}else{sixtyStream=renderer.domElement.captureStream(60)}}
  catch(e){sixtyStream=renderer.domElement.captureStream(60);toast('🎬 Canvas fallback · TTS may not be embedded',2800)}
  const mime=pickVideoMime();
  if(!mime){
    sixtyStream?.getTracks().forEach(t=>t.stop());
    sixtyStream=null;
    $('record60Btn').classList.remove('active');$('record60Btn').textContent='🎬';
    toast('⚠️ This browser cannot record video with MediaRecorder.',4200);
    return;
  }
  try{
    sixtyChunks=[];
    sixtyRecorder=new MediaRecorder(sixtyStream,{mimeType:mime,videoBitsPerSecond:14000000,audioBitsPerSecond:192000});
    sixtyRecorder.ondataavailable=e=>{if(e.data&&e.data.size)sixtyChunks.push(e.data)};
    sixtyRecorder.onstop=save60Recording;
    sixtyRecorder.start(500);
    setTimeout(startSprint,500);
    sixtyStopTimer=setTimeout(stop60Recording,60000);
  }catch(e){
    toast('⚠️ MP4 recorder failed: '+(e.message||e),3500);
    sixtyStream?.getTracks().forEach(t=>t.stop());
    sixtyStream=null;sixtyRecorder=null;
    $('record60Btn').classList.remove('active');$('record60Btn').textContent='🎬';
  }
}
function stop60Recording(){clearTimeout(sixtyStopTimer);if(sprint.active)stopSprint(true);if(sixtyRecorder&&sixtyRecorder.state!=='inactive')sixtyRecorder.stop()}
function save60Recording(){
  const mime=sixtyRecorder?.mimeType||'video/mp4';
  const isMP4=mime.startsWith('video/mp4'),blob=new Blob(sixtyChunks,{type:mime});
  const url=URL.createObjectURL(blob),a=document.createElement('a');
  a.href=url;
  a.download='Wisconsin-50-Fact-60s-'+new Date().toISOString().replace(/[:.]/g,'-')+(isMP4?'.mp4':'.webm');
  document.body.appendChild(a);a.click();a.remove();
  setTimeout(()=>URL.revokeObjectURL(url),4000);
  sixtyStream?.getTracks().forEach(t=>t.stop());
  sixtyStream=null;sixtyRecorder=null;sixtyChunks=[];
  $('record60Btn').classList.remove('active');$('record60Btn').textContent='🎬';
  toast(`💾 ${isMP4?'MP4':'WebM'} saved${mime.includes('mp4a')?' · AAC audio':''}`,3200);
}

renderer.domElement.addEventListener('pointerdown',e=>{if(mode==='turret'){if(document.pointerLockElement!==renderer.domElement){renderer.domElement.requestPointerLock?.();return}playerFire();return}pointer.set(e.clientX/innerWidth*2-1,-(e.clientY/innerHeight)*2+1);ray.setFromCamera(pointer,camera);const hits=ray.intersectObjects(interactive,true);if(hits.length){let o=hits[0].object;while(o&&o.userData.factIndex==null&&o.userData.turretIndex==null)o=o.parent;if(o?.userData.turretIndex!=null){activeTurretIndex=o.userData.turretIndex;possessTurret(activeTurretIndex);return}if(o?.userData.factIndex!=null){auto=false;updateTourButton();selectFact(o.userData.factIndex,true);if(o.userData.breakable)shatterCrystal(o.userData.factIndex)}}});
addEventListener('keydown',e=>{keys[e.code]=true;if(e.repeat)return;if(e.code==='Space'){e.preventDefault();mode==='turret'?playerFire():nextFact()}if(e.code==='Tab'){e.preventDefault();if(mode==='fleet'&&fleetLoaded.length){activeFleetIndex=(activeFleetIndex+(e.shiftKey?-1:1)+fleetLoaded.length)%fleetLoaded.length;fleetPlayer=fleetLoaded[activeFleetIndex];toast(`🚗 fleet ${activeFleetIndex+1}/${fleetLoaded.length}`)}else possessTurret(activeTurretIndex+(e.shiftKey?-1:1))}if(e.code==='KeyT')possessTurret(activeTurretIndex+1);if(e.code==='KeyG')viewDefense();if(e.code==='KeyI')enterCity(nearestMajorCity());if(e.code==='KeyV'&&mode==='turret'){turretCamMode=(turretCamMode+1)%3;toast(`🎥 Turret camera ${turretCamMode+1}/3`)}if(e.code==='KeyX')shatterCrystal(current);if(e.code==='KeyY')toggleTimeline();if(e.code==='KeyC')setMode('coaster');if(e.code==='KeyR')setMode('rover');if(e.code==='KeyB')setMode('boat');if(e.code==='KeyF')setMode('fly');if(e.code==='Digit7')setMode('whale');if(e.code==='Digit8')setMode('ship');if(e.code==='Digit9')setMode('angel');if(e.code==='KeyP')snapPNG()});addEventListener('keyup',e=>keys[e.code]=false);

$('yearPlay').onclick=toggleTimeline;
$('yearBack').onclick=()=>applyYear(simYear-100,true);
$('yearFwd').onclick=()=>applyYear(simYear+100,true);
$('yearRange').oninput=e=>{timelinePlaying=false;$('yearPlay').textContent='▶️ 100y';$('yearPlay').classList.remove('active');applyYear(+e.target.value)};
$('timelineBtn').onclick=()=>{$('timeline').style.display=$('timeline').style.display==='none'?'flex':'none';$('timelineBtn').classList.toggle('active',$('timeline').style.display!=='none')};
$('factsBtn').onclick=()=>{$('factsDrawer').classList.toggle('open');$('layersDrawer').classList.remove('open')};$('layersBtn').onclick=()=>{$('layersDrawer').classList.toggle('open');$('factsDrawer').classList.remove('open')};
document.querySelectorAll('[data-mode]').forEach(b=>b.onclick=()=>setMode(b.dataset.mode));$('prevBtn').onclick=prevFact;$('nextBtn').onclick=nextFact;$('tourBtn').onclick=()=>{if(auto){auto=false;updateTourButton();if('speechSynthesis'in window)speechSynthesis.cancel();toast('⏸ Tour paused')}else startAuto()};
$('sprintBtn').onclick=()=>sprint.active?stopSprint(false):startSprint();$('record60Btn').onclick=()=>sixtyRecorder?stop60Recording():start60Recording();$('burstBtn').onclick=()=>shatterCrystal(current);
$('voiceBtn').onclick=()=>{muted=!muted;voices.on=!muted;$('voiceBtn').textContent=muted?'🔇':'🔊';if(muted&&'speechSynthesis'in window)speechSynthesis.cancel();toast(muted?'🔇 Narration muted':'🔊 Narration on')};
$('visitBtn').onclick=()=>visitFact();$('rideBtn').onclick=()=>rideHere();$('speakBtn').onclick=()=>speakFact(FACTS[current]);$('pinBtn').onclick=dropPin;$('nearWaterBtn').onclick=()=>setMode('boat');$('search').oninput=renderFacts;
$('sprintLayerBtn').onclick=()=>toast('⚡ Sprint mode: 50 stops in ~56 seconds');$('shatterBtn').onclick=()=>shatterCrystal(current);$('wiViewBtn').onclick=viewWisconsin;$('basinViewBtn').onclick=viewBasin;$('resetBtn').onclick=viewWisconsin;$('clearPinsBtn').onclick=()=>{pins=[];pinGroup.clear();save();updateUI();toast('🧹 Pins cleared')};
function toggle(id,g){$(id).onclick=()=>{g.visible=!g.visible;$(id).classList.toggle('active',g.visible)}}toggle('greatLakesBtn',greatLakesGroup);toggle('waterBtn',waterGroup);toggle('terrainBtn',terrainGroup);toggle('regionBtn',regionGroup);toggle('forestBtn',forestGroup);$('roadsBtn').onclick=()=>{const v=!roadsGroup.visible;roadsGroup.visible=v;trafficGroup.visible=v;$('roadsBtn').classList.toggle('active',v)};$('citiesBtn').onclick=()=>{const v=!cityGroup.visible;cityGroup.visible=v;cityDetailGroup.visible=v;evolutionGroup.visible=v;$('citiesBtn').classList.toggle('active',v)};toggle('crystalBtn',crystalGroup);toggle('visualBtn',visualGroup);toggle('trackBtn',trackGroup);toggle('pinsBtn',pinGroup);toggle('labelsBtn',labelGroup);

const mini=$('miniCanvas'),mx=mini.getContext('2d'),wiRings=[];for(const poly of polygonsOf(wi))wiRings.push(poly[0].map(c=>projection(c)));
function drawMini(){mx.clearRect(0,0,mini.width,mini.height);const all=wiRings.flat();let minx=Infinity,maxx=-Infinity,miny=Infinity,maxy=-Infinity;all.forEach(p=>{minx=Math.min(minx,p[0]);maxx=Math.max(maxx,p[0]);miny=Math.min(miny,p[1]);maxy=Math.max(maxy,p[1])});const s=Math.min((mini.width-30)/(maxx-minx),(mini.height-30)/(maxy-miny)),cv=p=>[15+(p[0]-minx)*s,15+(p[1]-miny)*s];mx.fillStyle='rgba(36,93,57,.7)';mx.strokeStyle='rgba(143,233,255,.88)';mx.lineWidth=2;wiRings.forEach(r=>{mx.beginPath();r.forEach((p,i)=>{const q=cv(p);i?mx.lineTo(...q):mx.moveTo(...q)});mx.closePath();mx.fill();mx.stroke()});highwayLinks.forEach(h=>{const a=CITY_DATA[h.a],b=CITY_DATA[h.b],p=cv(projection([a.lon,a.lat])),q=cv(projection([b.lon,b.lat]));mx.strokeStyle=['#706f6a','#8b8b86','#aaa89e','#ded6aa','#ffe585'][h.stage];mx.lineWidth=1+h.stage*.55;mx.beginPath();mx.moveTo(...p);mx.lineTo(...q);mx.stroke()});CITY_DATA.forEach((c,i)=>{const q=cv(projection([c.lon,c.lat])),pop=majorCities[i]?.userData.pop||c.pop2020,rad=clamp(2+Math.log10(pop+1)*.65,2.5,6);mx.beginPath();mx.arc(q[0],q[1],rad,0,TAU);mx.fillStyle=i===localCityIndex?'#67ffc5':'#8eeaff';mx.fill()});FACTS.forEach((f,i)=>{const q=cv(projection([f.lon,f.lat]));mx.beginPath();mx.arc(q[0],q[1],i===current?4:1.5,0,TAU);mx.fillStyle=i===current?'#ffd46f':visited.has(f.n)?'#64ffc6':'rgba(235,250,255,.35)';mx.fill()});if(fleetLoaded.length){mx.font='11px Segoe UI Emoji';mx.textAlign='center';for(const v of fleetLoaded.slice(0,16)){const ll=projection.invert([v.position.x/WORLD_SCALE,v.position.z/WORLD_SCALE]);if(ll){const q=cv(projection(ll));mx.fillText('🚗',q[0],q[1])}}}const pp=pilotPos?.();if(pp){const ll=projection.invert([pp.x/WORLD_SCALE,pp.z/WORLD_SCALE]);if(ll){const q=cv(projection(ll));mx.font='16px Segoe UI Emoji';mx.textAlign='center';mx.fillText(mode==='whale'?'🐋':mode==='ship'?'⛵':mode==='angel'?'👼':mode==='fleet'?'🚗':mode==='turret'?'🎯':'🚙',q[0],q[1])}}}
let last=performance.now(),fpsT=0,fpsN=0;
function frame(now){const dt=Math.min(.05,(now-last)/1000||.016);last=now;if(fly){let u=Math.min(1,(now-fly.t0)/fly.dur);u=u*u*(3-2*u);camera.position.lerpVectors(fly.fromPos,fly.toPos,u);orbit.target.lerpVectors(fly.fromTarget,fly.toTarget,u);if(u>=1)fly=null}updateCoaster(dt,now);updateCrystalPhysics(dt,now);updateTimeline(dt);updateDefense(dt,now);updateMixers(dt);updateManualTurret(dt);updateDirector(now);updateWake(now);updateDefenseHUD(now);updateTraffic(dt);updateFleetAI(dt);updateEvolution(dt,now);updateCityStress(now);updateCityLOD(now);if(mode==='rover')moveRover(dt);if(mode==='boat')moveBoat(dt);if(mode==='whale')moveWhale(dt);if(mode==='ship')moveShip(dt);if(mode==='angel')moveAngel(dt);if(mode==='fleet')moveFleet(dt);flyKeys(dt);underwaterState();if(mode==='fly'||mode==='defense'||mode==='city')orbit.update();else if(mode==='coaster')coasterCam(dt);else if(mode==='turret')turretCamera(dt);else if(mode==='rover'||mode==='boat'||mode==='whale'||mode==='ship'||mode==='angel'||mode==='fleet'){const obj=mode==='rover'?rover:mode==='boat'?boat:mode==='whale'?whale:mode==='ship'?ship:mode==='angel'?angel:fleetPlayer;if(obj)chase(obj,dt,mode==='boat'||mode==='ship'||mode==='whale')}markerByIndex[current].rotation.y+=dt*.34;visualByIndex[current].rotation.y+=dt*.18;if(tinyCities[current])tinyCities[current].rotation.y+=dt*.10;drawMini();fpsN++;fpsT+=dt;if(fpsT>.7){const f=Math.round(fpsN/fpsT);$('fps').textContent=f;tunePerformance(f,now);fpsN=0;fpsT=0}renderer.render(scene,camera)}
renderer.setAnimationLoop(frame);addEventListener('resize',()=>{camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight)});
renderFacts();updateUI();viewDefense();setTimeout(()=>$('boot').classList.add('hide'),600);toast('🛡️ Tower Defense ready · click ⚔️ Start Wave · click any turret to possess',3600);
}catch(e){fail(e)}
