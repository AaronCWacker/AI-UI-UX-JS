function noise2(lat,lon){return Math.sin(lat*18.7+lon*13.1)*.48+Math.sin(lat*41.3-lon*24.9)*.24+Math.cos((lat+lon)*62.1)*.14}
function gauss(lat,lon,clat,clon,sy,sx){const dy=(lat-clat)/sy,dx=(lon-clon)/sx;return Math.exp(-(dx*dx+dy*dy)*1.55)}
function fallbackElevation(lat,lon){
