async function loadTerrariumDEM(z=8){
 const A=mercTile(47.15,-92.95,z),B=mercTile(42.45,-86.75,z);
 const x0=Math.floor(Math.min(A.x,B.x)),x1=Math.floor(Math.max(A.x,B.x)),y0=Math.floor(Math.min(A.y,B.y)),y1=Math.floor(Math.max(A.y,B.y)),tiles=new Map();
 const jobs=[];
 for(let ty=y0;ty<=y1;ty++)for(let tx=x0;tx<=x1;tx++)jobs.push((async()=>{
   const url=`https://s3.amazonaws.com/elevation-tiles-prod/terrarium/${z}/${tx}/${ty}.png`;
   const r=await fetch(url);if(!r.ok)throw Error(`DEM ${r.status}`);
   const bmp=await createImageBitmap(await r.blob()),c=document.createElement('canvas');c.width=c.height=256;const cx=c.getContext('2d',{willReadFrequently:true});cx.drawImage(bmp,0,0);tiles.set(`${tx}/${ty}`,cx.getImageData(0,0,256,256).data);bmp.close?.()
 })());
 await Promise.all(jobs);return{z,tiles}
}
let DEM=null;
function sampleDEM(lat,lon){
 if(!DEM)return NaN;const q=mercTile(lat,lon,DEM.z),tx=Math.floor(q.x),ty=Math.floor(q.y),a=DEM.tiles.get(`${tx}/${ty}`);if(!a)return NaN;
 const px=clamp(Math.floor((q.x-tx)*256),0,255),py=clamp(Math.floor((q.y-ty)*256),0,255),k=(py*256+px)*4;
 return a[k]*256+a[k+1]+a[k+2]/256-32768
}
function elevationMeters(lat,lon){const d=sampleDEM(lat,lon);return Number.isFinite(d)?clamp(d,176,610):fallbackElevation(lat,lon)}
function groundY(lat,lon){return SEA_Y+(elevationMeters(lat,lon)-176)*VERTICAL_EXAG}
function worldGround(x,z){const ll=projection.invert([x/WORLD_SCALE,z/WORLD_SCALE]);return ll?groundY(ll[1],ll[0]):SEA_Y}

