<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no">
<title>🛡️ Wisconsin Tower Defense · Great Lakes WebGPU Siege</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/peerjs/1.5.4/peerjs.min.js"></script>
<style>
:root{--bg:#02080c;--panel:#04131de8;--line:#79e4ff3b;--ink:#eefbff;--dim:#9cb9c6;--ice:#8eeaff;--mint:#67ffc5;--gold:#ffd46d;--hot:#ff6a7d}
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:var(--bg);color:var(--ink);font-family:Inter,"Segoe UI",system-ui,sans-serif}
canvas{display:block;touch-action:none}button,input{font:inherit}button{cursor:pointer;color:var(--ink);background:#071923e8;border:1px solid var(--line);border-radius:10px}
button:hover,button.active{border-color:var(--ice);background:#0c2a38;box-shadow:0 0 18px #6be7ff22}.panel{background:var(--panel);border:1px solid var(--line);backdrop-filter:blur(14px);box-shadow:0 12px 38px #0007}
#stage{position:fixed;inset:0}
#boot{position:fixed;inset:0;z-index:200;display:grid;place-items:center;text-align:center;background:radial-gradient(circle at 50% 38%,#124257,#02070a 70%);transition:.55s}
#boot.hide{opacity:0;pointer-events:none}.bootMark{font-size:64px}.bootTitle{font-size:clamp(26px,5vw,62px);font-weight:1000;letter-spacing:.055em}.bootSub{font-size:10px;color:var(--dim);letter-spacing:.17em;text-transform:uppercase}
#error{position:fixed;inset:12px;z-index:999;display:none;overflow:auto;white-space:pre-wrap;background:#310812ee;color:#ffe9ee;border:2px solid #ff6c80;border-radius:14px;padding:16px;font:12px ui-monospace,monospace}
#top{position:fixed;left:10px;right:10px;top:10px;z-index:40;display:flex;gap:7px;align-items:flex-start;justify-content:space-between;pointer-events:none}
.brand{pointer-events:auto;padding:9px 12px;border-radius:13px;border-left:3px solid var(--ice);max-width:min(640px,67vw)}.brand h1{font-size:clamp(15px,2.4vw,28px);margin:0;font-weight:950}.brand small{display:block;color:var(--gold);font-size:9px;letter-spacing:.11em;margin-top:2px}
.stats{display:flex;gap:5px;justify-content:flex-end;flex-wrap:wrap;pointer-events:auto}.chip{background:#04141ce8;border:1px solid var(--line);border-radius:999px;padding:5px 9px;font-size:9px;color:var(--dim);white-space:nowrap}.chip b{color:var(--ink)}
#factCard{position:fixed;left:50%;top:68px;transform:translateX(-50%);z-index:35;width:min(760px,75vw);padding:10px 14px;border-radius:14px;pointer-events:auto;text-align:center}
#factCard h2{margin:0;color:var(--gold);font-size:14px}#factCard .loc{font-size:9px;color:var(--ice);margin:2px 0 5px}#factText{font-size:11px;line-height:1.35}
#factCard .row{display:flex;justify-content:center;gap:5px;margin-top:7px;flex-wrap:wrap}#factCard button{padding:5px 8px;font-size:10px}
.drawer{position:fixed;z-index:38;top:78px;bottom:76px;width:min(340px,87vw);display:none;overflow:hidden;border-radius:15px}.drawer.open{display:flex;flex-direction:column}
#factsDrawer{left:10px}#layersDrawer{right:10px;height:auto;bottom:auto;max-height:73vh;padding:10px;display:none}#layersDrawer.open{display:block}
.drawerHead{padding:9px;border-bottom:1px solid var(--line)}#search{width:100%;background:#020b10;color:white;border:1px solid var(--line);border-radius:9px;padding:8px}
#facts{padding:6px;overflow:auto}.fact{width:100%;display:grid;grid-template-columns:38px 1fr auto;gap:6px;text-align:left;padding:7px 8px;margin:2px 0;border-color:transparent;background:transparent}.fact.sel{background:#123645;border-color:var(--ice)}.fact.visited .num{color:var(--gold)}.num{color:var(--mint);font-weight:900}.ft{font-size:11px;font-weight:800}.fl{font-size:8.5px;color:var(--dim);margin-top:2px}.pin{font-size:11px}
.layerGrid{display:grid;grid-template-columns:repeat(2,1fr);gap:6px}.layerGrid button{padding:8px;font-size:10px}
#dockWrap{position:fixed;left:0;right:0;bottom:max(6px,env(safe-area-inset-bottom));z-index:45;display:flex;justify-content:center;pointer-events:none}
#dock{pointer-events:auto;display:flex;gap:4px;align-items:center;max-width:calc(100vw - 12px);overflow:auto;padding:5px;border-radius:26px}.dockBtn{width:43px;height:43px;flex:0 0 43px;border-radius:50%;font-size:21px;padding:0}.sep{width:1px;height:26px;background:#ffffff22;flex:0 0 1px}
#modebar{position:fixed;left:50%;bottom:58px;transform:translateX(-50%);z-index:32;border-radius:999px;padding:5px 10px;font-size:9px;white-space:nowrap;max-width:86vw;overflow:hidden;text-overflow:ellipsis}
#mini{position:fixed;right:10px;bottom:78px;width:185px;height:210px;z-index:20;border-radius:12px;overflow:hidden;pointer-events:none}#miniCanvas{width:100%;height:100%}
#timeline{position:fixed;left:50%;bottom:112px;transform:translateX(-50%);z-index:37;width:min(720px,88vw);padding:8px 10px;border-radius:14px;display:flex;gap:8px;align-items:center;pointer-events:auto}#timeline input[type=range]{flex:1;min-width:100px;accent-color:var(--gold)}#timeline button{padding:6px 9px;font-size:11px;white-space:nowrap}#timeline .year{font-weight:950;color:var(--gold);min-width:52px;text-align:center}.timelineHint{font-size:8px;color:var(--dim);white-space:nowrap}@media(max-width:760px){#timeline{bottom:106px;width:94vw;padding:6px}.timelineHint{display:none}}
#toast{position:fixed;left:50%;top:58%;transform:translate(-50%,-50%);z-index:80;opacity:0;transition:.2s;padding:10px 15px;border-radius:12px;background:#041823f2;border:1px solid var(--ice);text-align:center;font-size:12px;pointer-events:none;max-width:74vw}.show{opacity:1!important}
#attrib{position:fixed;right:10px;bottom:69px;z-index:19;font-size:7px;color:#c8d9df99;background:#0005;padding:4px 6px;border-radius:6px;pointer-events:none}#help{position:fixed;left:10px;bottom:69px;z-index:20;font-size:8.5px;color:var(--dim);background:#0007;padding:5px 7px;border-radius:7px;pointer-events:none}
.progress{height:3px;background:#ffffff13;border-radius:3px;margin-top:7px;overflow:hidden}.progress i{display:block;height:100%;background:linear-gradient(90deg,var(--ice),var(--gold));width:0}
@media(max-width:760px){.brand{max-width:58vw}.brand h1{font-size:14px}.brand small{display:none}.stats{max-width:38vw}.chip{font-size:8px;padding:4px 6px}#factCard{top:58px;width:94vw;padding:8px 10px}#factText{font-size:10px;max-height:42px;overflow:auto}#mini{display:none}.drawer{top:118px;bottom:62px}.dockBtn{width:40px;height:40px;flex-basis:40px}#help{display:none}}

/* ---------- TOWER DEFENSE / MOVIE / WAKE ---------- */
#crosshair{position:fixed;left:50%;top:50%;width:28px;height:28px;transform:translate(-50%,-50%);z-index:67;display:none;pointer-events:none}
#crosshair:before,#crosshair:after{content:"";position:absolute;background:#dffcffdd;box-shadow:0 0 7px #72eaff}
#crosshair:before{left:13px;top:0;width:2px;height:28px}#crosshair:after{left:0;top:13px;width:28px;height:2px}
#crosshair i{position:absolute;inset:8px;border:1px solid #fff;border-radius:50%}
body.turretFP #crosshair{display:block}
#damageFlash{position:fixed;inset:0;z-index:66;pointer-events:none;opacity:0;background:radial-gradient(circle,transparent 35%,#ff3c4b55 100%);transition:opacity .12s}#damageFlash.on{opacity:1}
.toolPanel{position:fixed;z-index:54;right:10px;top:75px;width:min(390px,92vw);max-height:76vh;display:none;overflow:auto;padding:11px;border-radius:16px}.toolPanel.open{display:block}.toolPanel h3{font-size:11px;letter-spacing:.15em;color:var(--ice);margin:0 0 8px}.toolPanel .small{font-size:9.5px;line-height:1.45;color:var(--dim)}.toolPanel .row{display:flex;gap:5px;flex-wrap:wrap;align-items:center;margin:6px 0}.toolPanel button,.toolPanel input,.toolPanel select{border:1px solid var(--line);background:#061722;color:var(--ink);border-radius:9px;padding:7px;font-size:10px}.toolPanel input,.toolPanel select{min-width:0;flex:1}.toolPanel input[type=range]{padding:0;accent-color:var(--gold)}
#turretList{display:grid;grid-template-columns:repeat(2,1fr);gap:4px;margin-top:6px}.turretPick{text-align:left;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.turretPick.active{border-color:var(--gold);background:#352a0d}
#chatlog{height:170px;overflow:auto;background:#01070d;border:1px solid #ffffff12;border-radius:10px;padding:7px;font-size:10px}.msg{margin-bottom:5px}.name{color:var(--mint);font-weight:900}#players{display:grid;grid-template-columns:1fr 1fr;gap:4px}.playerTag{border:1px solid #ffffff14;border-radius:8px;padding:5px;font-size:9px}
.meterline{height:7px;border-radius:999px;background:#ffffff12;overflow:hidden;margin:5px 0}.meterline i{display:block;height:100%;background:linear-gradient(90deg,#6effc8,#ffd46d,#ff6a7d);width:100%}
#movieLive.live{color:#ff7b8d;font-weight:900;text-shadow:0 0 10px #ff5577}
body.cleanHUD #top,body.cleanHUD #factCard,body.cleanHUD #dockWrap,body.cleanHUD #timeline,body.cleanHUD #mini,body.cleanHUD #modebar,body.cleanHUD #help,body.cleanHUD #attrib,body.cleanHUD .drawer,body.cleanHUD .toolPanel{display:none!important}body.cleanHUD.turretFP #crosshair{display:block!important}
#turretRead{position:fixed;left:50%;top:15px;transform:translateX(-50%);z-index:52;display:none;padding:6px 11px;border-radius:999px;font-size:10px;pointer-events:none}body.turretFP #turretRead{display:block}
@media(max-width:760px){.toolPanel{top:112px;right:6px;width:calc(100vw - 12px);max-height:66vh}#turretList{grid-template-columns:1fr 1fr}}


/* ---------- CIVILIZATION / CITY EVOLUTION ---------- */
#cityStats{display:grid;grid-template-columns:1fr 1fr;gap:4px;margin-top:7px}.cityStat{padding:6px 7px;text-align:left;line-height:1.2;min-width:0}.cityStat b{display:block;color:var(--gold);font-size:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.cityStat span{font-size:8px;color:var(--dim)}.cityStat.active{border-color:var(--mint);background:#0d2d26}.sectionRule{height:1px;background:#ffffff16;margin:9px 0}.simBadge{display:inline-block;border:1px solid #ffffff18;border-radius:999px;padding:2px 6px;margin:1px;font-size:8px;color:var(--dim)}#gpsRead{font-size:8.5px;color:var(--mint);min-height:14px}.cityLegend{font-size:8px;color:var(--dim);line-height:1.35}.cityStat .pop{color:var(--ice);font-weight:900}.cityStat .road{color:var(--mint)}
body.cityLocal #factCard{opacity:.16;pointer-events:none}body.cityLocal #mini{opacity:.82}.localTag{color:var(--mint)}
@media(max-width:760px){#cityStats{grid-template-columns:1fr 1fr}.cityStat{padding:5px}}

</style>
</head>
<body>
<div id="stage"></div>
<div id="boot"><div><div class="bootMark">🛡️🎯🦡🌊</div><div class="bootTitle">WISCONSIN TOWER DEFENSE</div><div id="bootSub" class="bootSub">arming the Great Lakes world · WebGPU siege network</div></div></div>
<pre id="error"></pre>
<div id="top">
 <div class="brand panel"><h1>🛡️ Wisconsin Tower Defense</h1><small>STATE-SCALE WEBGPU SIEGE · POSSESS ANY TURRET · VEHICLES · MOVIE LAB · WAKE</small></div>
 <div class="stats"><span class="chip">GPU <b id="gpu">BOOT</b></span><span class="chip">FACT <b id="factStat">50/50</b></span><span class="chip">VISITED <b id="visitedStat">0</b></span><span class="chip">XP <b id="xpStat">0</b></span><span class="chip">SCALE <b>~1 km : 32u</b></span><span class="chip">TERRAIN <b id="terrainSrc">loading DEM</b></span><span class="chip">YEAR <b id="yearStat">2026</b></span><span class="chip">WAVE <b id="waveStat">0</b></span><span class="chip">BASE <b id="baseStat">100%</b></span><span class="chip">💰 <b id="creditStat">800</b></span><span class="chip">FOES <b id="enemyStat">0</b></span><span class="chip">WAKE <b id="peerStat">1</b></span><span class="chip">FPS <b id="fps">--</b></span></div>
</div>
<div id="factCard" class="panel">
 <h2 id="factTitle">🧊 Fact 50 · Ice Named Era</h2><div class="loc" id="factLoc">Kettle Moraine</div><div id="factText"></div>
 <div class="row"><button id="visitBtn">✈️ Visit</button><button id="rideBtn">🎢 Ride Here</button><button id="speakBtn">🗣️ Speak</button><button id="pinBtn">📍 Pin</button><button id="nearWaterBtn">🛥️ Nearest Water</button></div>
 <div class="progress"><i id="progress"></i></div>
</div>
<div id="factsDrawer" class="drawer panel"><div class="drawerHead"><input id="search" placeholder="🔎 Find fact, place, geology, fire…"></div><div id="facts"></div></div>
<div id="layersDrawer" class="drawer panel">
 <b style="color:var(--ice)">🏝️ WORLD LAYERS</b>
 <div class="layerGrid" style="margin-top:8px">
  <button id="greatLakesBtn" class="active">🌊 Great Lakes</button><button id="waterBtn" class="active">💧 Wisconsin Water</button>
  <button id="terrainBtn" class="active">⛰️ Topography</button><button id="regionBtn" class="active">🗺️ Region</button>
  <button id="forestBtn" class="active">🌲 Forests</button><button id="roadsBtn" class="active">🛣️ Roads</button>
  <button id="citiesBtn" class="active">🏙️ Living Cities</button><button id="timelineBtn" class="active">🕰️ Timeline</button>
  <button id="crystalBtn" class="active">💎 Crystals</button>
  <button id="trackBtn" class="active">🎢 Track</button><button id="shatterBtn">💥 Break</button>
  <button id="visualBtn" class="active">🎭 Dioramas</button><button id="sprintLayerBtn" class="active">⚡ Sprint Ready</button>
  <button id="pinsBtn" class="active">📍 Pins</button><button id="labelsBtn" class="active">🏷️ Labels</button>
  <button id="wiViewBtn">🦡 Wisconsin</button><button id="basinViewBtn">🌊 Great Lakes View</button>
  <button id="clearPinsBtn">🧹 Pins</button><button id="resetBtn">🏠 Reset</button>
 </div>
</div>

<div id="damageFlash"></div><div id="crosshair"><i></i></div><div id="turretRead" class="panel">🎯 <b id="turretName">—</b> · <span id="turretAmmo">AUTO</span></div>
<section id="defensePanel" class="toolPanel panel">
 <h3>🛡️ CIVILIZATION + DEFENSE GRID</h3>
 <div class="small">One live simulation: population grows cities, cities grow crystal-form architecture, roads widen into divided freeways, traffic emerges, disasters attack, and every turret stays possessable.</div>
 <div class="meterline"><i id="baseMeter"></i></div>
 <div class="row"><button id="waveBtn">⚔️ Start Wave</button><button id="hazardBtn">🌪️ Disaster</button><button id="possessBtn">🎯 Possess</button><button id="strategyBtn">🛰️ Strategy</button></div>
 <div class="row"><select id="towerType"><option value="cannon">💥 Cannon</option><option value="rail">⚡ Rail</option><option value="flak">🌪️ Flak</option><option value="missile">🚀 Missile</option></select><button id="buildTowerBtn">🏗️ Build @ Fact</button><button id="upgradeTowerBtn">⬆️ Upgrade</button></div>
 <div class="row"><button id="repairBaseBtn">🧰 Repair Base</button><button id="resetDefenseBtn">♻️ Reset Siege</button><button id="nextTurretBtn">⏭️ Turret</button></div>
 <div id="defenseRead" class="small">Wave 0 · civilization simulation ready</div><div id="turretList"></div>
 <div class="sectionRule"></div>
 <h3>🏙️ 100 YEARS / 60 SECONDS</h3>
 <div class="cityLegend">2020 Census population anchors drive relative scale; years between anchors are a procedural simulation, not historical census reconstruction. Crystal <b>forms</b> set symmetry; crystal <b>habits</b> set growth silhouette.</div>
 <div class="row"><button id="centuryBtn">▶️ 1926→2026</button><button id="cityViewBtn">🏙️ Enter City</button><button id="cityNextBtn">⏭️ City</button><button id="trafficBtn">🚦 Traffic</button></div>
 <div class="row"><input id="geoInput" placeholder="📍 ZIP or lat,lon"><button id="geoGo">🗺️ Import</button><button id="gpsBtn">🛰️ GPS</button></div><div id="gpsRead"></div>
 <div id="cityStats"></div>
</section>
<section id="moviePanel" class="toolPanel panel">
 <h3>🎬 MOVIE LAB</h3><div class="small">60fps canvas capture, full-screen/tab recording with audio, PNG stills, clean-HUD shots, and an automatic cinematic director. MP4/H.264 is preferred; WebM is used only when the browser cannot encode MP4.</div>
 <div class="row"><button id="movieRec">⏺️ Canvas</button><button id="screenRec">🖥️ Screen</button><button id="snapBtn">📸 PNG</button><button id="hudBtn">🫥 HUD</button></div>
 <div class="row"><button id="directorBtn">🎞️ Director</button><button id="cineShotBtn">🎥 Next Shot</button><select id="movieLimit"><option value="0">∞ manual</option><option value="30">30 sec</option><option value="60" selected>60 sec</option><option value="120">120 sec</option></select></div>
 <div id="movieLive" class="small">Recorder idle</div>
</section>
<section id="glbPanel" class="toolPanel panel">
 <h3>📦 GLB / GLTF BAY</h3><div class="small">Load once, auto-center/PBR-upgrade, then replace a turret/vehicle, skin new enemies, or drop a prop into the Wisconsin world. Embedded animations are played automatically.</div>
 <input id="glbFile" type="file" accept=".glb,.gltf" multiple><div class="row"><select id="glbTarget"><option value="turret">🎯 active turret</option><option value="rover">🚚 rover</option><option value="boat">🛥️ boat</option><option value="fleet">🚗 player + traffic fleet</option><option value="whale">🐋 whale</option><option value="ship">⛵ Viking ship</option><option value="enemy">👾 future enemies</option><option value="base">🏰 command base</option><option value="prop">🗿 prop @ fact</option></select><button id="glbApply">✅ Apply</button></div><div id="glbState" class="small">No model loaded</div>
</section>
<section id="wakePanel" class="toolPanel panel">
 <h3>📡 WAKE MULTIPLAYER</h3><div class="small">Auto-named PeerJS pilots share position, active turret, aim/fire events and chat. The first client becomes the Wake relay; later clients auto-join.</div>
 <div id="players"></div><div id="chatlog"></div><div class="row"><input id="chat" maxlength="280" placeholder="say something to Wake…"><button id="sendChat">📡</button><button id="rerollName">🎲</button></div><div id="wakeRead" class="small">starting…</div>
</section>

<div id="mini" class="panel"><canvas id="miniCanvas" width="370" height="420"></canvas></div>
<div id="timeline" class="panel"><button id="yearPlay" title="Run 100 simulated years in 60 seconds">▶️ 100y</button><button id="yearBack" title="100 years back">⏪</button><input id="yearRange" type="range" min="1650" max="2026" step="1" value="2026"><button id="yearFwd" title="100 years forward">⏩</button><span class="year" id="yearNow">2026</span><span class="timelineHint">100 years = 60 seconds · population → roads → traffic</span></div>
<div id="modebar" class="panel"><span id="modeText">🎢 COASTER · Wisconsin statewide route</span></div>
<div id="dockWrap"><div id="dock" class="panel">
 <button class="dockBtn" id="factsBtn" title="Facts">📚</button>
 <button class="dockBtn active" data-mode="defense" title="Tower defense strategy">🛡️</button>
 <button class="dockBtn" data-mode="turret" title="Possess turret">🎯</button>
 <button class="dockBtn" data-mode="coaster" title="Coaster">🎢</button>
 <button class="dockBtn" data-mode="rover" title="Rover">🚚</button>
 <button class="dockBtn" data-mode="boat" title="Boat">🛥️</button><button class="dockBtn" data-mode="whale" title="Blue whale / Great Lakes dive">🐋</button><button class="dockBtn" data-mode="ship" title="Oseberg Viking longship">⛵</button><button class="dockBtn" data-mode="angel" title="Angel flight">👼</button><button class="dockBtn" data-mode="fleet" title="Imported GLB fleet driver">🚗</button>
 <button class="dockBtn" data-mode="fly" title="Fly">🛰️</button>
 <span class="sep"></span>
 <button class="dockBtn" id="prevBtn">⏮️</button><button class="dockBtn" id="tourBtn">▶️</button><button class="dockBtn" id="nextBtn">⏭️</button>
 <button class="dockBtn" id="voiceBtn">🔊</button><button class="dockBtn" id="sprintBtn" title="50 stops in under one minute">⚡</button><button class="dockBtn" id="record60Btn" title="Record 60-second fact tour">🎬</button><button class="dockBtn" id="burstBtn" title="Break active crystal">💥</button><button class="dockBtn" id="layersBtn">🏝️</button>
 <span class="sep"></span><button class="dockBtn" data-tool="defense" title="Defense controls">⚔️</button><button class="dockBtn" data-tool="movie" title="Movie lab">🎥</button><button class="dockBtn" data-tool="glb" title="GLB loader">📦</button><button class="dockBtn" data-tool="wake" title="Wake multiplayer">📡</button><button class="dockBtn" id="quickSnap" title="PNG screenshot">📸</button>
</div></div>
<div id="help">🛡️ G strategy · I enter city · T/Tab turret · WASD drive/swim/fly · Q/E steer · Z/C depth/altitude · Shift boost · C coaster · R rover · B boat · W whale via dock · V turret camera · P PNG</div><div id="attrib">Elevation: Mapzen/Tilezen Terrain Tiles via AWS Open Data · Lakes: Natural Earth</div>
